// BizBoosters — Phase 0 schema (identity only).
// Rooms, cards, decks, inventory and the token ledger arrive in phases 1–3;
// see docs/DATA-MODEL.md for the full target schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  student
  educator
  school_admin
  super_admin
}

enum InvitationRole {
  educator
  school_admin
}

model School {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  timezone  String   @default("UTC")
  createdAt DateTime @default(now()) @map("created_at")

  users       User[]
  invitations EducatorInvitation[]
  rooms       Room[]
  cards       Card[]

  @@map("schools")
}

model User {
  id       String   @id @default(uuid()) @db.Uuid
  schoolId String?  @map("school_id") @db.Uuid
  role     UserRole

  displayName String @map("display_name")

  /// Educators only. Stored lowercase — see normalizeIdentifier(); a CHECK
  /// constraint in the migration rejects anything else, so no code path can
  /// bypass normalization and create a case-duplicate account.
  email String? @unique

  /// Students only. Same lowercase rule.
  loginId String? @unique @map("login_id")

  passwordHash       String  @map("password_hash")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  isActive           Boolean @default(true) @map("is_active")

  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  lastLoginAt      DateTime? @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school            School?              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sessions          Session[]
  invitationsSent   EducatorInvitation[] @relation("InvitedBy")
  invitationDddress EducatorInvitation[] @relation("AcceptedBy")
  auditActed        AuditLog[]           @relation("AuditActor")
  auditTargeted     AuditLog[]           @relation("AuditTarget")
  roomsCreated      Room[]               @relation("RoomCreator")
  cardsCreated      Card[]               @relation("CardCreator")
  roomEducator      RoomEducator[]
  enrollments       Enrollment[]
  tokenActions      TokenTransaction[]
  activityActed     ActivityEvent[]
  notifications     Notification[]
  acknowledgements  CardUseAcknowledgement[]

  @@index([schoolId, role])
  @@map("users")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  /// Rolling-expiry bookkeeping: refreshed on activity, but only once the
  /// session is far enough through its window to be worth a write.
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model EducatorInvitation {
  id         String         @id @default(uuid()) @db.Uuid
  schoolId   String         @map("school_id") @db.Uuid
  email      String
  role       InvitationRole @default(educator)
  tokenHash  String         @unique @map("token_hash")
  invitedBy  String         @map("invited_by") @db.Uuid
  expiresAt  DateTime       @map("expires_at")
  acceptedAt DateTime?      @map("accepted_at")
  acceptedBy String?        @map("accepted_by") @db.Uuid
  revokedAt  DateTime?      @map("revoked_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  inviter  User   @relation("InvitedBy", fields: [invitedBy], references: [id])
  acceptor User?  @relation("AcceptedBy", fields: [acceptedBy], references: [id])

  @@index([schoolId, email])
  @@map("educator_invitations")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  targetUserId String?  @map("target_user_id") @db.Uuid
  action       String
  payload      Json     @default("{}")
  ip           String?
  createdAt    DateTime @default(now()) @map("created_at")

  actor  User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target User? @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([targetUserId, createdAt])
  @@map("audit_log")
}

/// Fixed-window rate limiting. In Postgres rather than in memory so it still
/// works when the app runs as more than one instance (or as serverless
/// functions, where in-process counters are worthless).
model RateLimit {
  key         String   @id
  windowStart DateTime @map("window_start")
  count       Int      @default(0)

  @@index([windowStart])
  @@map("rate_limits")
}

// ─── Phase 1: rooms, enrolments, tokens, activity ──────────────────────────

enum RoomStatus {
  draft
  active
  archived
}

enum RoomEducatorRole {
  owner
  assistant
}

enum EnrollmentStatus {
  active
  removed
}

enum TokenReason {
  educator_award
  educator_adjustment
  draw_spend
  draw_refund
  system_correction
}

model Room {
  id       String     @id @default(uuid()) @db.Uuid
  schoolId String     @map("school_id") @db.Uuid
  name     String
  status   RoomStatus @default(active)

  // Economy rules. Deck-specific settings arrive with the deck in phase 2.
  drawCostTokens     Int     @default(20) @map("draw_cost_tokens")
  tradesEnabled      Boolean @default(true) @map("trades_enabled")
  tradeRatio         Int     @default(3) @map("trade_ratio")
  studentsSeeOdds    Boolean @default(true) @map("students_see_odds")
  lowStockThreshold  Int     @default(20) @map("low_stock_threshold")
  lowStockAlerted    Boolean @default(false) @map("low_stock_alerted")

  /// Optimistic concurrency for settings edits: two educators editing the same
  /// room must not silently overwrite each other.
  version Int @default(1)

  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  school      School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  creator     User            @relation("RoomCreator", fields: [createdBy], references: [id])
  educators   RoomEducator[]
  enrollments Enrollment[]
  activity    ActivityEvent[]
  roomCards   RoomCard[]
  rarities    RoomRarity[]
  inventory       InventoryItem[]
  draws           Draw[]
  notifications   Notification[]
  acknowledgements CardUseAcknowledgement[]

  @@index([schoolId, status])
  @@map("rooms")
}

model RoomEducator {
  roomId String           @map("room_id") @db.Uuid
  userId String           @map("user_id") @db.Uuid
  role   RoomEducatorRole @default(assistant)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
  @@map("room_educators")
}

/// One row per (student, room). Tokens hang off THIS, not off the user — a
/// student in three rooms has three independent balances.
model Enrollment {
  id        String           @id @default(uuid()) @db.Uuid
  roomId    String           @map("room_id") @db.Uuid
  studentId String           @map("student_id") @db.Uuid
  status    EnrollmentStatus @default(active)

  /// Cache of SUM(token_transactions.delta), maintained in the same
  /// transaction as the ledger row. A CHECK constraint keeps it non-negative.
  tokenBalance Int @default(0) @map("token_balance")

  seatLabel String?   @map("seat_label")
  joinedAt  DateTime  @default(now()) @map("joined_at")
  removedAt DateTime? @map("removed_at")

  room         Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  student      User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  transactions TokenTransaction[]
  activity     ActivityEvent[]
  inventory    InventoryItem[]
  draws        Draw[]
  trades       Trade[]

  @@unique([roomId, studentId])
  @@index([studentId, status])
  @@map("enrollments")
}

/// Append-only. Never updated, never deleted — an award that was wrong is
/// corrected by a compensating row, so the history stays answerable.
model TokenTransaction {
  id           String      @id @default(uuid()) @db.Uuid
  enrollmentId String      @map("enrollment_id") @db.Uuid
  delta        Int
  balanceAfter Int         @map("balance_after")
  reason       TokenReason
  note         String?
  actorUserId  String?     @map("actor_user_id") @db.Uuid

  /// Set on the compensating row that reverses this one, and on the original
  /// once reversed — so neither can be undone twice.
  reversesId  String?  @unique @map("reverses_id") @db.Uuid
  batchId     String?  @map("batch_id") @db.Uuid

  /// What caused this movement, when it was not an educator action — e.g. the
  /// draw that spent the tokens. Loose reference on purpose: the ledger must
  /// outlive whatever it points at.
  relatedType String?  @map("related_type")
  relatedId   String?  @map("related_id") @db.Uuid

  createdAt   DateTime @default(now()) @map("created_at")

  enrollment Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  actor      User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  reverses   TokenTransaction? @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy TokenTransaction? @relation("Reversal")

  @@index([enrollmentId, createdAt])
  @@map("token_transactions")
}

/// The room's shared history. Every mutation writes exactly one row per
/// affected student; see docs/MECHANICS.md §7 for the event vocabulary.
model ActivityEvent {
  id                  String  @id @default(uuid()) @db.Uuid
  roomId              String  @map("room_id") @db.Uuid
  type                String
  actorUserId         String? @map("actor_user_id") @db.Uuid
  subjectEnrollmentId String? @map("subject_enrollment_id") @db.Uuid

  /// Snapshots the human-readable detail (card names, amounts, notes) so a
  /// later rename or edit never rewrites what the log said happened.
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  room          Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  actor         User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  subject       Enrollment?    @relation(fields: [subjectEnrollmentId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([roomId, createdAt])
  @@index([subjectEnrollmentId, createdAt])
  @@map("activity_events")
}

// ─── Phase 2: card catalog and room decks ──────────────────────────────────

enum RarityCode {
  C
  U
  R
  L
}

/// A card DEFINITION: name, art, rarity. Owned by the school and reusable in
/// every room. Distinct from stock (RoomCard) and from an owned copy
/// (phase 3) — see docs/DATA-MODEL.md §1.
model Card {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @map("school_id") @db.Uuid

  /// The power-up name. Required: it is what the activity log, notifications
  /// and inventory display. Editable at any time.
  name String

  /// Optional — the card art states the effect and educators know it from the
  /// name, so this is a convenience field.
  effectText  String? @map("effect_text")
  description String?

  rarity RarityCode

  /// Object-storage key, never a URL: the bucket can move without a data
  /// migration. Null until art is uploaded.
  imageKey String? @map("image_key")
  /// Original import URL. Provenance only; never served to users.
  sourceUrl String? @map("source_url")

  isArchived Boolean  @default(false) @map("is_archived")
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  school    School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  creator   User            @relation("CardCreator", fields: [createdBy], references: [id])
  roomCards RoomCard[]
  inventory InventoryItem[]
  draws     Draw[]

  @@unique([schoolId, name])
  @@index([schoolId, rarity])
  @@map("cards")
}

/// The finite shared deck for one room: how many copies exist, and how many are
/// currently in the deck rather than in a student's hand.
model RoomCard {
  id     String @id @default(uuid()) @db.Uuid
  roomId String @map("room_id") @db.Uuid
  cardId String @map("card_id") @db.Uuid

  /// Educators edit THIS. `copiesRemaining` is system-owned.
  copiesTotal Int @map("copies_total")
  /// Copies currently in the deck. total - remaining = copies held by students.
  copiesRemaining Int @map("copies_remaining")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@unique([roomId, cardId])
  @@index([roomId])
  @@map("room_cards")
}

/// Per-room labels and colours for the four rarities. Keeps the enum stable
/// while letting a room rename "Legendary" to "Founder Tier".
model RoomRarity {
  roomId    String     @map("room_id") @db.Uuid
  code      RarityCode
  label     String
  colorHex  String     @map("color_hex")
  sortOrder Int        @map("sort_order")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([roomId, code])
  @@map("room_rarities")
}

// ─── Phase 3: draws and inventory ──────────────────────────────────────────

/// Only `owned` holds a copy out of the deck. The rest are terminal history
/// rows whose copy is already back in circulation — see docs/MECHANICS.md §3.
enum ItemState {
  owned
  used
  returned
  revoked
}

enum Acquisition {
  draw
  trade
  educator_grant
}

enum DrawKind {
  token_draw
  trade_upgrade
}

/// One row per copy a student has held. The UI stacks by card for display.
model InventoryItem {
  id           String @id @default(uuid()) @db.Uuid
  enrollmentId String @map("enrollment_id") @db.Uuid
  /// Denormalised so "how many copies are held out of this room's deck" is one
  /// index scan rather than a join through enrollments.
  roomId String @map("room_id") @db.Uuid
  cardId String @map("card_id") @db.Uuid

  state       ItemState   @default(owned)
  acquiredVia Acquisition
  acquiredAt  DateTime    @default(now()) @map("acquired_at")
  usedAt      DateTime?   @map("used_at")
  returnedAt  DateTime?   @map("returned_at")
  studentNote String?     @map("student_note")
  drawId      String?     @map("draw_id") @db.Uuid

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  room       Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  card       Card       @relation(fields: [cardId], references: [id], onDelete: Restrict)
  draw       Draw?      @relation(fields: [drawId], references: [id])

  @@index([enrollmentId, state])
  @@index([roomId, cardId, state])
  @@map("inventory_items")
}

model Draw {
  id            String   @id @default(uuid()) @db.Uuid
  roomId        String   @map("room_id") @db.Uuid
  enrollmentId  String   @map("enrollment_id") @db.Uuid
  kind          DrawKind @default(token_draw)
  tokenCost     Int      @default(0) @map("token_cost")
  resultCardId  String   @map("result_card_id") @db.Uuid
  resultRarity  RarityCode @map("result_rarity")

  /// Provenance for dispute resolution: what the deck actually looked like, and
  /// what the roll was. "The game cheated me" has to be an answerable question.
  poolSnapshot Json   @map("pool_snapshot")
  rollValue    Int    @map("roll_value")
  poolSize     Int    @map("pool_size")

  /// Client-generated per button press. Makes a double-click, a retry, or a
  /// lost response safe: the same key replays the original result instead of
  /// charging twice.
  idempotencyKey String   @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  room       Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  enrollment Enrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  card       Card            @relation(fields: [resultCardId], references: [id])
  items      InventoryItem[]
  trade      Trade?

  @@unique([enrollmentId, idempotencyKey])
  @@index([roomId, createdAt])
  @@map("draws")
}

// ─── Phase 4: use, trades, notifications ───────────────────────────────────

/// Per-recipient delivery and read state. Stored as rows first and pushed
/// second: SSE is best-effort, so a dropped connection must never lose a
/// notification — the client reconciles from this table on reconnect.
model Notification {
  id              String  @id @default(uuid()) @db.Uuid
  recipientUserId String  @map("recipient_user_id") @db.Uuid
  roomId          String? @map("room_id") @db.Uuid
  activityEventId String? @map("activity_event_id") @db.Uuid

  type      String
  payload   Json      @default("{}")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  recipient User           @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  room      Room?          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  event     ActivityEvent? @relation(fields: [activityEventId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, createdAt])
  @@index([recipientUserId, readAt])
  @@map("notifications")
}

/// The educator's "I honoured this perk" tick-box.
///
/// Gates nothing — the card is already spent and already back in the deck. It
/// exists because a teacher who gets six use notifications during one lesson
/// needs to tell which ones they have actually acted on, and reading a
/// notification is a different event from honouring a perk.
model CardUseAcknowledgement {
  inventoryItemId String   @id @map("inventory_item_id") @db.Uuid
  roomId          String   @map("room_id") @db.Uuid
  acknowledgedBy  String   @map("acknowledged_by") @db.Uuid
  acknowledgedAt  DateTime @default(now()) @map("acknowledged_at")
  note            String?

  item Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [acknowledgedBy], references: [id], onDelete: Cascade)

  @@index([roomId, acknowledgedAt])
  @@map("card_use_acknowledgements")
}

/// The prototype's marketplace upgrade, recorded against the draw it produced.
model Trade {
  id            String     @id @default(uuid()) @db.Uuid
  drawId        String     @unique @map("draw_id") @db.Uuid
  enrollmentId  String     @map("enrollment_id") @db.Uuid
  fromRarity    RarityCode @map("from_rarity")
  toRarity      RarityCode @map("to_rarity")
  /// The inventory items surrendered, so the trade is reconstructable.
  consumedItems String[]   @map("consumed_items") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at")

  draw       Draw       @relation(fields: [drawId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId, createdAt])
  @@map("trades")
}
