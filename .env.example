# Postgres. Locally this is the docker-compose service; in production use your
# managed instance (Supabase, Neon, RDS...).
DATABASE_URL="postgresql://bizboosters:bizboosters@localhost:5432/bizboosters?schema=public"

# Supabase has three connection strings and they are not interchangeable.
# Copy the exact values out of Connect → ORMs → Prisma; the hostnames below are
# shapes, not addresses.
#
#   Serverless runtime (Netlify) — transaction pooler, port 6543.
#   `pgbouncer=true` is not optional: without it Prisma sends prepared
#   statements the pooler cannot honour and you get
#   "prepared statement s0 already exists" under load.
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"
#
#   Migrations and admin scripts — session pooler, port 5432. `prisma migrate`
#   needs session-level features the transaction pooler does not provide, so
#   run those commands with DATABASE_URL set to this string instead.
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Public origin, used to build invitation links in emails.
APP_URL="http://localhost:3000"

# Session cookie name. Change only if you need to run two deployments on one host.
SESSION_COOKIE_NAME="bb_session"

# "console" prints emails to the server log (development).
# "smtp" sends for real and requires the SMTP_* values below.
MAIL_TRANSPORT="console"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# MAIL_FROM="BizBoosters <no-reply@example.com>"

# ─── Card art storage ───────────────────────────────────────────────────────
# With no S3_BUCKET set, art is written to STORAGE_DIR on local disk and served
# by the app. That is fine for development and for a single long-lived server,
# but useless on serverless, where the filesystem is ephemeral.
STORAGE_DIR="./storage"

# Production: any S3-compatible bucket (Supabase Storage, Cloudflare R2, AWS
# S3, MinIO). Supabase Storage speaks S3, so it needs no new code — take the
# region and keys from Storage → S3 Connection.
# S3_BUCKET="card-art"
# S3_REGION="ap-southeast-1"
# S3_ENDPOINT="https://<ref>.storage.supabase.co/storage/v1/s3"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# Public/CDN base URL for the bucket. Set it and images are served straight
# from the CDN; leave it unset and the app proxies them.
# For a public Supabase bucket:
# S3_PUBLIC_BASE_URL="https://<ref>.supabase.co/storage/v1/object/public/card-art"

# Nightly reconciliation endpoint. Unset disables the route entirely.
# CRON_SECRET=""

# ─── Live updates ───────────────────────────────────────────────────────────
# The app pushes changes over server-sent events, which needs a host that lets a
# connection stay open. Serverless hosts do not: they kill the function at their
# execution limit, and every reconnect bills another full function lifetime.
#
# Set both of these to "off" on Netlify, Vercel or any per-second-billed
# platform. Clients then poll every 30 seconds instead — nothing is lost except
# instant updates, and function compute drops enormously.
# LIVE_UPDATES="off"
# NEXT_PUBLIC_LIVE_UPDATES="off"
