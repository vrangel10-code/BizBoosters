# Postgres. Locally this is the docker-compose service; in production use your
# managed instance (Neon, Supabase, RDS...).
DATABASE_URL="postgresql://bizboosters:bizboosters@localhost:5432/bizboosters?schema=public"

# Public origin, used to build invitation links in emails.
APP_URL="http://localhost:3000"

# Session cookie name. Change only if you need to run two deployments on one host.
SESSION_COOKIE_NAME="bb_session"

# "console" prints emails to the server log (development).
# "smtp" sends for real and requires the SMTP_* values below.
MAIL_TRANSPORT="console"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# MAIL_FROM="BizBoosters <no-reply@example.com>"

# ─── Card art storage ───────────────────────────────────────────────────────
# With no S3_BUCKET set, art is written to STORAGE_DIR on local disk and served
# by the app. That is fine for development and for a single long-lived server,
# but useless on serverless, where the filesystem is ephemeral.
STORAGE_DIR="./storage"

# Production: any S3-compatible bucket (Cloudflare R2, AWS S3, MinIO).
# S3_BUCKET="bizboosters-cards"
# S3_REGION="auto"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# Public/CDN base URL for the bucket. Set it and images are served straight
# from the CDN; leave it unset and the app proxies them.
# S3_PUBLIC_BASE_URL="https://cards.example.com"

# Nightly reconciliation endpoint. Unset disables the route entirely.
# CRON_SECRET=""
